generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String  @id @default(uuid())
  email String  @unique
  senha String  @default("123456")
  nome  String?

  // Mantendo os seus campos originais intactos:
  altura    Float?
  pesoAtual Float?
  createdAt DateTime @default(now())

  // Relacionamentos:
  WorkoutLog  WorkoutLog[]
  WorkoutPlan WorkoutPlan[]
  WeightLog   WeightLog[]
  WorkoutSession WorkoutSession[]
}

model WeightLog {
  id        Int      @id @default(autoincrement())
  peso      Float
  data      DateTime @default(now())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Exercise {
  id            Int           @id @default(autoincrement())
  nome          String
  grupoMuscular String
  equipamento   String?
  ficha         String        @default("A")
  workoutItems  WorkoutItem[]
  logs          WorkoutLog[]
}

model WorkoutPlan {
  id     String  @id @default(uuid())
  userId String
  nome   String
  ativa  Boolean @default(true)

  user  User          @relation(fields: [userId], references: [id])
  items WorkoutItem[]
}

model WorkoutItem {
  id               String @id @default(uuid())
  planId           String
  exerciseId       Int
  series           Int
  repeticoes       String
  descansoSegundos Int

  plan     WorkoutPlan @relation(fields: [planId], references: [id])
  exercise Exercise    @relation(fields: [exerciseId], references: [id])
}

model WorkoutLog {
  id         String   @id @default(uuid())
  userId     String
  exerciseId Int
  data       DateTime @default(now())
  carga      Float
  repsFeitas Int

  user     User     @relation(fields: [userId], references: [id])
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  sessionId       String?         // <-- ADICIONE ESTA LINHA
  session         WorkoutSession? @relation(fields: [sessionId], references: [id]) // <-- ADICIONE ESTA LINHA
}

// Nova tabela para agrupar o treino do dia
model WorkoutSession {
  id        String       @id @default(uuid())
  startTime DateTime     @default(now())
  endTime   DateTime?    // Nulo enquanto o treino está rolando
  calories  Float?       // Calculado no fim

  userId    String
  user      User         @relation(fields: [userId], references: [id])
  logs      WorkoutLog[] // Séries realizadas nesta sessão
}
