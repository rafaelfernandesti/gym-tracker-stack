generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String  @id @default(uuid())
  email String  @unique
  senha String  @default("123456")
  nome  String?

  // Mantendo os seus campos originais intactos:
  altura    Float?
  pesoAtual Float?
  createdAt DateTime @default(now())

  // Relacionamentos:
  WorkoutLog  WorkoutLog[]
  WorkoutPlan WorkoutPlan[]
}

model Exercise {
  id            Int           @id @default(autoincrement())
  nome          String
  grupoMuscular String
  equipamento   String?
  ficha         String        @default("A")
  workoutItems  WorkoutItem[]
  logs          WorkoutLog[]
}

model WorkoutPlan {
  id     String  @id @default(uuid())
  userId String
  nome   String
  ativa  Boolean @default(true)

  user  User          @relation(fields: [userId], references: [id])
  items WorkoutItem[]
}

model WorkoutItem {
  id               String @id @default(uuid())
  planId           String
  exerciseId       Int
  series           Int
  repeticoes       String
  descansoSegundos Int

  plan     WorkoutPlan @relation(fields: [planId], references: [id])
  exercise Exercise    @relation(fields: [exerciseId], references: [id])
}

model WorkoutLog {
  id         String   @id @default(uuid())
  userId     String
  exerciseId Int
  data       DateTime @default(now())
  carga      Float
  repsFeitas Int

  user     User     @relation(fields: [userId], references: [id])
  exercise Exercise @relation(fields: [exerciseId], references: [id])
}
