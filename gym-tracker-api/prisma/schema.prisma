generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  senha     String
  nome      String?
  foto      String?
  altura    Float?
  pesoAtual Float?
  createdAt DateTime @default(now())

  WorkoutLog      WorkoutLog[]
  WorkoutSession  WorkoutSession[]
  customExercises Exercise[]
  workoutPlans    WorkoutPlan[]
  weightLogs      WeightLog[]
}

model WeightLog {
  id   Int      @id @default(autoincrement())
  peso Float
  data DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Exercise {
  id            Int     @id @default(autoincrement()) // ID é INT
  nome          String
  grupoMuscular String?
  userId        String?
  user          User?   @relation(fields: [userId], references: [id])

  WorkoutLog  WorkoutLog[]
  WorkoutPlan WorkoutPlan[]
}

// ESTA É A NOVA TABELA DE FICHAS
model WorkoutPlan {
  id         Int    @id @default(autoincrement()) // ID é INT
  userId     String
  exerciseId Int // Precisa ser INT para bater com Exercise.id
  ficha      String // "A", "B", "C"
  seriesAlvo Int @default(3)
  ordem Int @default(0)
  user     User     @relation(fields: [userId], references: [id])
  exercise Exercise @relation(fields: [exerciseId], references: [id])
  
  
}

model WorkoutLog {
  id         String   @id @default(uuid())
  userId     String
  exerciseId Int
  data       DateTime @default(now())
  carga      Float
  repsFeitas Int

  user     User     @relation(fields: [userId], references: [id])
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  sessionId String? // <-- ADICIONE ESTA LINHA
  session   WorkoutSession? @relation(fields: [sessionId], references: [id]) // <-- ADICIONE ESTA LINHA
}

// Nova tabela para agrupar o treino do dia
model WorkoutSession {
  id        String    @id @default(uuid())
  startTime DateTime  @default(now())
  endTime   DateTime? // Nulo enquanto o treino está rolando
  calories  Float? // Calculado no fim

  userId String
  user   User         @relation(fields: [userId], references: [id])
  logs   WorkoutLog[] // Séries realizadas nesta sessão
}
